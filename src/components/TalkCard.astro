---
interface Props {
	id: string;
	org?: string;
	title: string;
	speaker?: string;
	description?: string;
	track?: string;
	room?: string;
	vimeo?: string;
}

const { id, org, title, speaker, description, track, room, vimeo } =
	Astro.props;

// Split description into paragraphs by blank lines.
const paragraphs = description
	? description
			.split(/\n\s*\n/)
			.map((p) => p.trim())
			.filter(Boolean)
	: [];
---

<div class="schedule-talk" data-talk-id={id}>
  <button
    type="button"
    class="favourite-btn js-only"
    data-talk-id={id}
    aria-pressed="false"
    aria-label="Legg til i mine favoritter"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="favourite-icon">
      <path
        d="M12 2.5l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.8 5.9 21.1l1.4-6.8L2.2 9.6l6.9-.8L12 2.5z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"
      />
    </svg>
  </button>
  {org && <span class="schedule-org">{org}</span>}
  {room && <span class="schedule-room">{room}</span>}
  {track && <span class="schedule-track">{track}</span>}
  <h3 class="ds-heading" data-size="sm">{title}</h3>
  {speaker && <span class="ds-paragraph schedule-speaker" data-size="sm">{speaker}</span>}
  {paragraphs.length > 0 && (
    <div class="schedule-description">
      {paragraphs.map(p => <p class="ds-paragraph" data-size="sm" set:html={p} />)}
    </div>
  )}
  {vimeo && (

      <a class="ds-link" href={vimeo}>
        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="none" viewBox="0 0 24 24" focusable="false" role="img" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M4 5.25A1.75 1.75 0 0 0 2.25 7v10c0 .966.784 1.75 1.75 1.75h16A1.75 1.75 0 0 0 21.75 17V7A1.75 1.75 0 0 0 20 5.25zM3.75 7A.25.25 0 0 1 4 6.75h16a.25.25 0 0 1 .25.25v10a.25.25 0 0 1-.25.25H4a.25.25 0 0 1-.25-.25zm6.614 1.844A.75.75 0 0 0 9.25 9.5v5a.75.75 0 0 0 1.114.656l4.5-2.5a.75.75 0 0 0 0-1.312zM12.956 12l-2.206 1.225v-2.45z" clip-rule="evenodd"></path></svg>
        Se opptak av {title} på vimeo.com
        </a>
  )}
</div>
